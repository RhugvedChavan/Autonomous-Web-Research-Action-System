# Mistral AI API Key
# Sign up and get free-tier API key at: https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# Tavily Web Search API Key
# Sign up and get free search credits at: https://app.tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# Model Configuration (default: mistral-small-latest, supports mistral-large-latest, open-mistral-7b)
MISTRAL_MODEL=mistral-small-latest

# Browser Automation & Scraper Settings
PLAYWRIGHT_HEADLESS=true
MAX_SEARCH_RESULTS=5
API_TIMEOUT_SECONDS=45
PORT=8000
